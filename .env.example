BOT_NAME=Nexa
PREFIX=.
OWNER_NAME=Vyrael
OWNER_NUMBER=
OWNER_EMAIL=zavriel.studio@gmail.com
OWNER_TIKTOK=zavriel.ud
AUTH_DIR=auth_info
DATA_DIR=data
LOG_LEVEL=info
METRICS_TOKEN=

# Runtime HTTP probe. Railway may provide PORT automatically.
HEALTH_HOST=0.0.0.0
HEALTH_PORT=3000

# Authentication: leave PAIRING_NUMBER blank for QR. A WhatsApp account is still required.
PAIRING_NUMBER=

# Runtime protection
COMMAND_COOLDOWN_MS=2500
MAX_COMMANDS_PER_WINDOW=3
MAX_MESSAGE_LENGTH=8000
MAX_MEDIA_BYTES=8388608
MAX_STORED_USERS=50000
MAX_STORED_GROUPS=10000
STORE_FLUSH_MS=15000

# Moderation
WARN_LIMIT=3

# Optional AI (OpenAI-compatible /chat/completions)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TURNS=6
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_RETRY_BASE_MS=250
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RESET_MS=30000
